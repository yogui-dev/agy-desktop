{
  "name": "agy-desktop",
  "version": "1.0.0",
  "description": "Antigravity CLI Desktop Control Plane — Multi-Session Telemetry, Path Locking & Chat",
  "main": "electron/main.cjs",
  "author": "yoguidev",
  "private": true,
  "scripts": {
    "dev:ui": "vite",
    "dev:electron": "electron .",
    "dev": "concurrently -k \"pnpm dev:ui\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:ui": "vite build",
    "pack:asar": "node scripts/pack-asar.cjs",
    "build": "pnpm build:ui && pnpm pack:asar",
    "dist": "pnpm build && electron-builder --win",
    "dist:portable": "pnpm build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.yoguidev.agydesktop",
    "productName": "AGY Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AGY Desktop"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  }
}
